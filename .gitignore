# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Workspace dependency checksums
go.work.sum

# env file
.env

# Editor/IDE
.idea/
# .vscode/

# Python environments and test caches
.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# Playwright MCP snapshots, logs and screenshots
.playwright-mcp/

# Deployment settings, generated secrets, the Lambda environment, database dumps
# and the smoke test's guest credential (deploy/README.md), and the Ansible
# collections scripts/vm.sh installs
deploy/local/
deploy/ansible/.collections/

# Terraform's providers and any state or plan outside deploy/local/. State and
# plans hold the Lambda's secrets.
.terraform/
*.tfstate*
*.tfplan

# Web client dependencies and build output
node_modules/
dist/
