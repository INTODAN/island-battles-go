{
  "components": {
    "schemas": {
      "Castle": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Castle ID, stable for the whole game.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "description": "Owning team; 0 is neutral.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "upgrades": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "description": "Every upgrade type's level. GET /game/upgrades lists the levels and what the next one costs.",
            "propertyNames": {
              "$ref": "#/components/schemas/UpgradeType"
            },
            "type": "object"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "team_color",
          "soldiers",
          "x",
          "y",
          "upgrades"
        ],
        "type": "object"
      },
      "CastleTemplate": {
        "additionalProperties": false,
        "properties": {
          "starting_soldier_amount": {
            "description": "Soldiers in the castle when a game starts. Defaults to neutral_starting_soldier_amount.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "description": "Owning team colour, from 1 to player_amount; 0 is neutral.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "upgrades": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "description": "Starting level of each upgrade type. Omitted types start at level 1.",
            "propertyNames": {
              "$ref": "#/components/schemas/UpgradeType"
            },
            "type": "object"
          },
          "x": {
            "description": "Distance from the centre of the plane, between -plane_size_x/2 and plane_size_x/2.",
            "format": "double",
            "type": "number"
          },
          "y": {
            "description": "Distance from the centre of the plane, between -plane_size_y/2 and plane_size_y/2.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "team_color",
          "x",
          "y"
        ],
        "type": "object"
      },
      "Clash": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Identifies the clash within its generation.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/ClashParticipant"
            },
            "type": "array"
          },
          "time": {
            "description": "Fraction of the turn at which contact happened.",
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "time",
          "participants"
        ],
        "type": "object"
      },
      "ClashParticipant": {
        "additionalProperties": false,
        "properties": {
          "clash_radius": {
            "exclusiveMinimum": 0,
            "format": "double",
            "type": "number"
          },
          "group_id": {
            "description": "Soldier group ID; the group may no longer exist.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers_after": {
            "description": "Soldiers immediately after this contact; 0 means the group was defeated.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers_before": {
            "description": "Soldiers immediately before this contact.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "group_id",
          "team_color",
          "x",
          "y",
          "clash_radius",
          "soldiers_before",
          "soldiers_after"
        ],
        "type": "object"
      },
      "ConnectionToken": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ConnectionToken.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "websocket_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_at",
          "websocket_url"
        ],
        "type": "object"
      },
      "ConnectionTokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ConnectionTokenInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "GameEndedEvent": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "enum": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/GenerationState",
            "description": "The final generation, with its outcome."
          },
          "type": {
            "enum": [
              "game.ended"
            ],
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "type",
          "state"
        ],
        "type": "object"
      },
      "GameOutcome": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "last_team_standing: one team was left after every other team lost all its castles and soldier groups. all_eliminated: the last teams were eliminated in the same turn, a draw. generation_cap: the game reached its last generation; the team with the most castles won, and equal counts are a draw.",
            "enum": [
              "last_team_standing",
              "all_eliminated",
              "generation_cap"
            ],
            "type": "string"
          },
          "summary": {
            "description": "The outcome in one sentence, naming the winning team.",
            "type": "string"
          },
          "winner_team_color": {
            "description": "The winning team, or null for a draw.",
            "format": "int64",
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "reason",
          "winner_team_color",
          "summary"
        ],
        "type": "object"
      },
      "Generation": {
        "additionalProperties": false,
        "properties": {
          "castles": {
            "items": {
              "$ref": "#/components/schemas/Castle"
            },
            "type": "array"
          },
          "clashes": {
            "items": {
              "$ref": "#/components/schemas/Clash"
            },
            "type": "array"
          },
          "id": {
            "description": "Generation ID; increases with every turn.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "soldier_groups": {
            "items": {
              "$ref": "#/components/schemas/SoldierGroup"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "castles",
          "soldier_groups",
          "clashes"
        ],
        "type": "object"
      },
      "GenerationEvent": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "enum": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/GenerationState"
          },
          "type": {
            "enum": [
              "game.next_generation"
            ],
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "type",
          "state"
        ],
        "type": "object"
      },
      "GenerationState": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/GenerationState.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "channel": {
            "description": "Your personal Centrifugo channel, which receives GenerationEvent after each turn and GameEndedEvent after the last one.",
            "type": "string"
          },
          "game_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "generation": {
            "$ref": "#/components/schemas/Generation"
          },
          "generation_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "lobby_id": {
            "format": "uuid",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/GameOutcome",
            "description": "How the game ended. Absent while the game runs. A finished game keeps its final generation and rejects every command."
          },
          "player_id": {
            "format": "uuid",
            "type": "string"
          },
          "submitted": {
            "description": "Whether you completed this generation's turn.",
            "type": "boolean"
          },
          "team_color": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "game_id",
          "lobby_id",
          "generation_id",
          "player_id",
          "team_color",
          "channel",
          "submitted",
          "generation"
        ],
        "type": "object"
      },
      "ListMapTemplatesResponseBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ListMapTemplatesResponseBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "maps": {
            "items": {
              "$ref": "#/components/schemas/MapTemplateSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "maps"
        ],
        "type": "object"
      },
      "ListUpgradesResponseBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ListUpgradesResponseBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "upgrades": {
            "items": {
              "$ref": "#/components/schemas/Upgrade"
            },
            "type": "array"
          }
        },
        "required": [
          "upgrades"
        ],
        "type": "object"
      },
      "LobbySettings": {
        "additionalProperties": false,
        "description": "Island Battles game_settings for a lobby create request. Choose at most one map: map_template_id or map. The map must be made for exactly the lobby's teams: player_amount equal to the team count, and castle team colours exactly 1 to that count, in team order, with 0 for neutral castles. Without a map the game starts on a generated map. An invalid choice fails lobby creation with invalid_game_settings, and its detail names each invalid field, such as game_settings.map.castles[0].x.",
        "properties": {
          "map": {
            "$ref": "#/components/schemas/MapTemplate",
            "description": "Start on this map file. Cannot be combined with map_template_id."
          },
          "map_template_id": {
            "description": "Start on this default map, a map_template_id from GET /map/templates. Cannot be combined with map.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "MapTemplate": {
        "additionalProperties": false,
        "properties": {
          "castles": {
            "description": "Each castle's position in the list is its castle ID in every game built from the map.",
            "items": {
              "$ref": "#/components/schemas/CastleTemplate"
            },
            "minItems": 1,
            "type": "array"
          },
          "map_name": {
            "description": "Name of the map, unique among default maps.",
            "minLength": 1,
            "type": "string"
          },
          "neutral_starting_soldier_amount": {
            "description": "Soldiers in every castle, owned or neutral, that sets no starting_soldier_amount.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "plane_size_x": {
            "description": "Width of the plane, which is centred on the origin.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "plane_size_y": {
            "description": "Height of the plane, which is centred on the origin.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "player_amount": {
            "description": "Players the map is made for. Castle team colours run from 1 to player_amount.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "castles",
          "map_name",
          "player_amount",
          "plane_size_y",
          "plane_size_x",
          "neutral_starting_soldier_amount"
        ],
        "type": "object"
      },
      "MapTemplateSummary": {
        "additionalProperties": false,
        "properties": {
          "castle_count": {
            "description": "Castles on the map, team and neutral.",
            "format": "int64",
            "type": "integer"
          },
          "map_name": {
            "type": "string"
          },
          "map_template_id": {
            "description": "Choose the map by passing this ID as game_settings.map_template_id when creating a lobby.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "plane_size_x": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "plane_size_y": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_count": {
            "description": "Teams the map is made for, its player_amount. A lobby on this map has exactly this many teams, in team colour order.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "map_template_id",
          "map_name",
          "team_count",
          "plane_size_x",
          "plane_size_y",
          "castle_count"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthenticated",
              "not_found",
              "not_host",
              "lobby_full",
              "team_full",
              "phase_conflict",
              "not_ready",
              "empty_teams",
              "stale_membership",
              "idempotency_conflict",
              "invalid_input",
              "invalid_game_settings",
              "unavailable",
              "internal_error"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "team_ids": {
            "description": "The teams the error is about. For empty_teams, the teams that still need a player, in team order.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "PublicGenerationCommand": {
        "discriminator": {
          "mapping": {
            "send_soldier_group": "#/components/schemas/SendSoldierGroupCommand",
            "upgrade_castle": "#/components/schemas/UpgradeCastleCommand"
          },
          "propertyName": "command_type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/SendSoldierGroupCommand"
          },
          {
            "$ref": "#/components/schemas/UpgradeCastleCommand"
          }
        ]
      },
      "RegisterGenerationCommands": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/RegisterGenerationCommands.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "commands": {
            "items": {
              "$ref": "#/components/schemas/PublicGenerationCommand"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "complete": {
            "description": "Seals your turn after this batch. Defaults to true.",
            "type": "boolean"
          },
          "game_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "generation_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "description": "Identifies this batch. Retry a lost request with the same UUID and body; use a new UUID for every new batch.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "generation_id",
          "request_id",
          "commands"
        ],
        "type": "object"
      },
      "SendSoldierGroupCommand": {
        "additionalProperties": false,
        "properties": {
          "command_type": {
            "enum": [
              "send_soldier_group"
            ],
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/SendSoldierGroupParameters"
          }
        },
        "required": [
          "command_type",
          "parameters"
        ],
        "type": "object"
      },
      "SendSoldierGroupParameters": {
        "additionalProperties": false,
        "properties": {
          "destination_castle_id": {
            "description": "Any other castle.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "origin_castle_id": {
            "description": "Castle your team owns.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldier_amount": {
            "description": "Soldiers to send; counts against soldiers already reserved by your team this turn.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "origin_castle_id",
          "destination_castle_id",
          "soldier_amount"
        ],
        "type": "object"
      },
      "SoldierGroup": {
        "additionalProperties": false,
        "properties": {
          "clash_radius": {
            "description": "Enemies clash when their centers are within the larger of their radii.",
            "exclusiveMinimum": 0,
            "format": "double",
            "type": "number"
          },
          "destination_castle_id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "description": "Soldier group ID, never reassigned within a game.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "origin_castle_id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "description": "Owning team; 0 is neutral.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "upgrades": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "description": "Every upgrade type's level, copied from the origin castle when the group left.",
            "propertyNames": {
              "$ref": "#/components/schemas/UpgradeType"
            },
            "type": "object"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "team_color",
          "soldiers",
          "x",
          "y",
          "origin_castle_id",
          "destination_castle_id",
          "clash_radius",
          "upgrades"
        ],
        "type": "object"
      },
      "Upgrade": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "description": "What the levels' values measure.",
            "type": "string"
          },
          "levels": {
            "description": "Every level from 1 to max_level, in order.",
            "items": {
              "$ref": "#/components/schemas/UpgradeLevel"
            },
            "type": "array"
          },
          "max_level": {
            "description": "The highest level. Every castle starts at level 1.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/UpgradeType"
          }
        },
        "required": [
          "type",
          "description",
          "max_level",
          "levels"
        ],
        "type": "object"
      },
      "UpgradeCastleCommand": {
        "additionalProperties": false,
        "properties": {
          "command_type": {
            "enum": [
              "upgrade_castle"
            ],
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/UpgradeCastleParameters"
          }
        },
        "required": [
          "command_type",
          "parameters"
        ],
        "type": "object"
      },
      "UpgradeCastleParameters": {
        "additionalProperties": false,
        "properties": {
          "castle_id": {
            "description": "Castle your team owns. It pays the level's soldier_cost from GET /game/upgrades.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "upgrade_type": {
            "$ref": "#/components/schemas/UpgradeType",
            "description": "The type to raise by one level. Several upgrades of a castle in one turn each buy the next level."
          }
        },
        "required": [
          "castle_id",
          "upgrade_type"
        ],
        "type": "object"
      },
      "UpgradeLevel": {
        "additionalProperties": false,
        "properties": {
          "level": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "soldier_cost": {
            "description": "Soldiers the castle pays to reach this level from the level below. Level 1 is free.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "value": {
            "description": "The level's effect, in the unit its type's description names.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "level",
          "value",
          "soldier_cost"
        ],
        "type": "object"
      },
      "UpgradeType": {
        "description": "A castle upgrade. GET /game/upgrades lists each type's levels and costs.",
        "enum": [
          "clash_stop_generations",
          "speed"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "LobbyBearer": {
        "description": "Guest bearer credential issued by POST /lobby/v1/sessions. This is distinct from a Centrifugo connection JWT.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Operations a player client calls during a started game. After every turn, each roster player's Centrifugo channel `player:{player_id}` receives a `GenerationEvent`, except after the turn that ends the game, which pushes a `GameEndedEvent` with the final generation and its outcome instead. Clients reconcile with the generation read after subscribing or reconnecting; HTTP state is authoritative, and its `outcome` is set once the game has ended. `MapTemplate` is the map file format, which `POST /map/create` accepts. `LobbySettings` is the `game_settings` object of an Island Battles lobby create request; `GET /map/templates` lists the default maps it can choose. `GET /game/upgrades` lists what each castle upgrade level costs.",
    "title": "Island Battles Player API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/game/from-lobby/{lobby_id}/generation": {
      "get": {
        "description": "Requires a place on the game's frozen roster. The game does not consult the lobby, so access continues after the lobby is deleted. Returns castle and soldier group IDs, which are never reassigned within a game, troop state, recorded clashes with per-participant before/after counts, your turn completion flag, and the outcome once the game has ended. A finished game stays readable until the game is deleted, 7 days after its last generation by default; then this returns 404.",
        "operationId": "getIslandLobbyGeneration",
        "parameters": [
          {
            "in": "path",
            "name": "lobby_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationState"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Read the current generation for a roster player",
        "tags": [
          "Island Battles"
        ]
      }
    },
    "/game/upgrades": {
      "get": {
        "description": "Lists every upgrade type, sorted by type, with what its levels measure and, for each level from 1 to max_level, its effect and the soldiers a castle pays to reach it from the level below. Every castle starts at level 1. The table is static and needs no authentication. Castles and soldier groups carry their current levels, and upgrade_castle in POST /generation/commands buys the next one.",
        "operationId": "listUpgrades",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListUpgradesResponseBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the castle upgrades, their levels and their costs."
      }
    },
    "/generation/commands": {
      "post": {
        "description": "Requires a place on the game's frozen roster; the lobby is not consulted. Players send send_soldier_group and upgrade_castle commands for castles their team owns; other command types are forbidden (403). upgrade_castle buys the next level of one upgrade type and pays that level's soldier_cost, listed by GET /game/upgrades, from the castle's soldiers. A castle may be upgraded several times in one turn, and each upgrade buys the next level. Every command is checked against the generation and every command already accepted this turn, yours and your teammates', so an accepted command cannot fail when the turn runs. An invalid command rejects the whole batch, and nothing of it is stored. Malformed parameters are 422. Rejections that clients tell apart carry a problem type: a castle that is not in the generation is 422 urn:island-battles:problem:castle-not-found, an unknown upgrade_type is 422 urn:island-battles:problem:unknown-upgrade-type, a castle your team does not own is 403 urn:island-battles:problem:castle-not-owned, an upgrade past its type's max_level, counting this turn's upgrades, is 409 urn:island-battles:problem:upgrade-max-level, and soldiers or an upgrade cost beyond what the castle has left after this turn's reservations is 409 urn:island-battles:problem:insufficient-soldiers. A castle may spend all its soldiers. Complete defaults to true; an empty batch can complete a turn. The last frozen roster completion advances exactly once. The game ends after the turn that leaves one team with castles or soldier groups, a draw when the last teams are eliminated in the same turn, or after the turn that creates generation 300, where the team with the most castles wins. That turn's generation is the last, its state carries the outcome, and every later command conflicts (409) with problem type urn:island-battles:problem:game-ended. Retry the same request UUID and payload safely, also after the game ended; changed payloads and stale new requests conflict.",
        "operationId": "registerGenerationCommand",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterGenerationCommands"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationState"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Register an atomic player command batch and optionally complete the turn",
        "tags": [
          "Island Battles"
        ]
      }
    },
    "/lobby/v1/connection-token": {
      "post": {
        "description": "Creates an authenticated Centrifugo connection token; it never creates or joins a lobby.",
        "operationId": "createLobbyConnectionToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionTokenInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionToken"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Create a connection token",
        "tags": [
          "Lobby"
        ]
      }
    },
    "/map/templates": {
      "get": {
        "description": "Lists every default map whose castle team colours are exactly 1 to player_amount, ordered by name. Choose one when creating an Island Battles lobby by passing its map_template_id in game_settings, with exactly team_count teams. Maps that fit no lobby are left out: those whose team colours skip a colour, and those made for fewer than 2 or more than 16 teams.",
        "operationId": "listMapTemplates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMapTemplatesResponseBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the default maps a lobby can start on."
      }
    }
  }
}
