{
  "components": {
    "schemas": {
      "Castle": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Castle ID, stable for the whole game.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "description": "Owning team; 0 is neutral.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "team_color",
          "soldiers",
          "x",
          "y"
        ],
        "type": "object"
      },
      "Clash": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Identifies the clash within its generation.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/ClashParticipant"
            },
            "type": "array"
          },
          "time": {
            "description": "Fraction of the turn at which contact happened.",
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "time",
          "participants"
        ],
        "type": "object"
      },
      "ClashParticipant": {
        "additionalProperties": false,
        "properties": {
          "clash_radius": {
            "exclusiveMinimum": 0,
            "format": "double",
            "type": "number"
          },
          "group_id": {
            "description": "Soldier group ID; the group may no longer exist.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers_after": {
            "description": "Soldiers immediately after this contact; 0 means the group was defeated.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers_before": {
            "description": "Soldiers immediately before this contact.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "group_id",
          "team_color",
          "x",
          "y",
          "clash_radius",
          "soldiers_before",
          "soldiers_after"
        ],
        "type": "object"
      },
      "ConnectionToken": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ConnectionToken.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "websocket_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_at",
          "websocket_url"
        ],
        "type": "object"
      },
      "ConnectionTokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ConnectionTokenInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Generation": {
        "additionalProperties": false,
        "properties": {
          "castles": {
            "items": {
              "$ref": "#/components/schemas/Castle"
            },
            "type": "array"
          },
          "clashes": {
            "items": {
              "$ref": "#/components/schemas/Clash"
            },
            "type": "array"
          },
          "id": {
            "description": "Generation ID; increases with every turn.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "soldier_groups": {
            "items": {
              "$ref": "#/components/schemas/SoldierGroup"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "castles",
          "soldier_groups",
          "clashes"
        ],
        "type": "object"
      },
      "GenerationEvent": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "enum": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/GenerationState"
          },
          "type": {
            "enum": [
              "game.next_generation"
            ],
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "type",
          "state"
        ],
        "type": "object"
      },
      "GenerationState": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/GenerationState.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "channel": {
            "description": "Your personal Centrifugo channel, which receives GenerationEvent.",
            "type": "string"
          },
          "game_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "generation": {
            "$ref": "#/components/schemas/Generation"
          },
          "generation_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "lobby_id": {
            "format": "uuid",
            "type": "string"
          },
          "player_id": {
            "format": "uuid",
            "type": "string"
          },
          "submitted": {
            "description": "Whether you completed this generation's turn.",
            "type": "boolean"
          },
          "team_color": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "game_id",
          "lobby_id",
          "generation_id",
          "player_id",
          "team_color",
          "channel",
          "submitted",
          "generation"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthenticated",
              "not_found",
              "not_host",
              "lobby_full",
              "team_full",
              "phase_conflict",
              "not_ready",
              "stale_membership",
              "idempotency_conflict",
              "invalid_input",
              "unavailable",
              "internal_error"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "PublicGenerationCommand": {
        "additionalProperties": false,
        "properties": {
          "command_type": {
            "enum": [
              "send_soldier_group"
            ],
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/SendSoldierGroupParameters"
          }
        },
        "required": [
          "command_type",
          "parameters"
        ],
        "type": "object"
      },
      "RegisterGenerationCommands": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/RegisterGenerationCommands.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "commands": {
            "items": {
              "$ref": "#/components/schemas/PublicGenerationCommand"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "complete": {
            "description": "Seals your turn after this batch. Defaults to true.",
            "type": "boolean"
          },
          "game_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "generation_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "description": "Identifies this batch. Retry a lost request with the same UUID and body; use a new UUID for every new batch.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "generation_id",
          "request_id",
          "commands"
        ],
        "type": "object"
      },
      "SendSoldierGroupParameters": {
        "additionalProperties": false,
        "properties": {
          "destination_castle_id": {
            "description": "Any other castle.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "origin_castle_id": {
            "description": "Castle your team owns.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldier_amount": {
            "description": "Soldiers to send; counts against soldiers already reserved by your team this turn.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "origin_castle_id",
          "destination_castle_id",
          "soldier_amount"
        ],
        "type": "object"
      },
      "SoldierGroup": {
        "additionalProperties": false,
        "properties": {
          "clash_radius": {
            "description": "Enemies clash when their centers are within the larger of their radii.",
            "exclusiveMinimum": 0,
            "format": "double",
            "type": "number"
          },
          "destination_castle_id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "description": "Soldier group ID, never reassigned within a game.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "origin_castle_id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soldiers": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "team_color": {
            "description": "Owning team; 0 is neutral.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "team_color",
          "soldiers",
          "x",
          "y",
          "origin_castle_id",
          "destination_castle_id",
          "clash_radius"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "LobbyBearer": {
        "description": "Guest bearer credential issued by POST /lobby/v1/sessions. This is distinct from a Centrifugo connection JWT.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Operations a player client calls during a started game. After every turn, each roster player's Centrifugo channel `player:{player_id}` receives a `GenerationEvent`. Clients reconcile with the generation read after subscribing or reconnecting; HTTP state is authoritative.",
    "title": "Island Battles Player API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/game/from-lobby/{lobby_id}/generation": {
      "get": {
        "description": "Requires a place on the game's frozen roster. The game does not consult the lobby, so access continues after the lobby is deleted. Returns castle and soldier group IDs, which are never reassigned within a game, troop state, recorded clashes with per-participant before/after counts, and your turn completion flag.",
        "operationId": "getIslandLobbyGeneration",
        "parameters": [
          {
            "in": "path",
            "name": "lobby_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationState"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Read the current generation for a roster player",
        "tags": [
          "Island Battles"
        ]
      }
    },
    "/generation/commands": {
      "post": {
        "description": "Requires a place on the game's frozen roster; the lobby is not consulted. Only owned send_soldier_group commands are accepted; other command types are forbidden (403). Complete defaults to true; an empty batch can complete a turn. The last frozen roster completion advances exactly once. A game stops at 300 generations, and commands for its last generation conflict. Retry the same request UUID and payload safely; changed payloads and stale new requests conflict.",
        "operationId": "registerGenerationCommand",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterGenerationCommands"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationState"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Register an atomic player command batch and optionally complete the turn",
        "tags": [
          "Island Battles"
        ]
      }
    },
    "/lobby/v1/connection-token": {
      "post": {
        "description": "Creates an authenticated Centrifugo connection token; it never creates or joins a lobby.",
        "operationId": "createLobbyConnectionToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionTokenInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionToken"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "LobbyBearer": []
          }
        ],
        "summary": "Create a connection token",
        "tags": [
          "Lobby"
        ]
      }
    }
  }
}
