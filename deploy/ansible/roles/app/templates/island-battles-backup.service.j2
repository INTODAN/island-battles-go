# {{ ansible_managed }}
# Dumps {{ postgres_database }} and {{ lobby_database }} and uploads the dumps to
# S3 (deploy/README.md, "Backups"). Its log: journalctl -u island-battles-backup
[Unit]
Description=Back up the {{ postgres_database }} and {{ lobby_database }} databases to S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ vm_app_dir }}
EnvironmentFile={{ app_backup_settings_dir }}/backup.env
ExecStart=/usr/local/sbin/island-battles-backup
NoNewPrivileges=true
PrivateTmp=true
