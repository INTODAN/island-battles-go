# {{ ansible_managed }}
# Settings for island-battles-backup (deploy/README.md, "Backups"), with the
# upload-only AWS key from deploy/local/secrets/database_backups.json.
ISLAND_BATTLES_APP_DIR={{ vm_app_dir }}
# Both databases: the backend's and the lobby's own (#229).
ISLAND_BATTLES_DATABASES={{ postgres_database }} {{ lobby_database }}
ISLAND_BATTLES_MOVED_AWAY_MARKER={{ app_moved_away_marker }}
ISLAND_BATTLES_BACKUP_BUCKET={{ app_database_backups.bucket }}
ISLAND_BATTLES_BACKUP_PREFIX={{ app_database_backups.prefix }}
ISLAND_BATTLES_BACKUP_REGION={{ app_database_backups.region }}
ISLAND_BATTLES_BACKUP_METRIC_NAMESPACE={{ app_database_backups.metric_namespace }}
ISLAND_BATTLES_BACKUP_METRIC_NAME={{ app_database_backups.metric_name }}
AWS_ACCESS_KEY_ID={{ app_database_backups.access_key_id }}
AWS_SECRET_ACCESS_KEY={{ app_database_backups.secret_access_key }}
