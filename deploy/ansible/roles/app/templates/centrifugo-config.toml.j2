# {{ ansible_managed }}
# Centrifugo 6.9.6 configuration for the VM. Secrets come from centrifugo.env.
#
# The client, proxy and channel settings mirror the development configuration in
# lobby/centrifugo/centrifugo-config.toml. Change both together.

[http_server]
# Docker publishes host port 443 to this port.
port = 8000
# Only the health endpoint is served here, as plain HTTP for the container's
# healthcheck. It isn't published.
internal_address = "127.0.0.1"
internal_port = "9000"
tls_external = true

# Let's Encrypt certificate for vm.<domain>. The TLS-ALPN-01 challenge is
# answered on 443, so port 80 stays closed.
[http_server.tls_autocert]
enabled = true
host_whitelist = ["{{ vm_hostname }}"]
cache_dir = "/centrifugo/autocert"
email = "{{ app_letsencrypt_email }}"
http = false

# The backend runs on Lambda and reaches the API over the internet, so the API is
# served on the public TLS port and protected by its key (CENTRIFUGO_HTTP_API_KEY).
[http_api]
external = true

[admin]
enabled = false

[health]
enabled = true

[client]
# The lobby UI and the demo player are served from the game's URL, through
# CloudFront. The proxy endpoints below call the Function URL directly.
allowed_origins = ["{{ app_game_origin }}"]

[client.subscribe_to_user_personal_channel]
enabled = false
single_connection = false

[channel.proxy.subscribe]
endpoint = "{{ app_lambda_origin }}/internal/lobby/centrifugo/subscribe"
timeout = "{{ app_centrifugo_proxy_timeout }}"

[channel.proxy.subscribe.http]
static_headers = { "X-Lobby-Proxy-Secret" = "${CENTRIFUGO_VAR_LOBBY_PROXY_SECRET}" }

[channel.proxy.sub_refresh]
endpoint = "{{ app_lambda_origin }}/internal/lobby/centrifugo/sub-refresh"
timeout = "{{ app_centrifugo_proxy_timeout }}"

[channel.proxy.sub_refresh.http]
static_headers = { "X-Lobby-Proxy-Secret" = "${CENTRIFUGO_VAR_LOBBY_PROXY_SECRET}" }

[channel.without_namespace]
allow_subscribe_for_client = false
allow_subscribe_for_anonymous = false
allow_publish_for_client = false
allow_publish_for_subscriber = false
allow_publish_for_anonymous = false
allow_history_for_client = false
allow_history_for_subscriber = false
allow_history_for_anonymous = false
allow_presence_for_client = false
allow_presence_for_subscriber = false
allow_presence_for_anonymous = false
allow_user_limited_channels = false
join_leave = false
force_push_join_leave = false

[[channel.namespaces]]
name = "lobby"
subscribe_proxy_enabled = true
sub_refresh_proxy_enabled = true
history_size = 128
history_ttl = "300s"
force_recovery = true
force_positioning = true
allow_publish_for_client = false
allow_publish_for_subscriber = false
allow_publish_for_anonymous = false
allow_history_for_client = false
allow_history_for_subscriber = false
allow_history_for_anonymous = false
allow_presence_for_client = false
allow_presence_for_subscriber = false
allow_presence_for_anonymous = false
allow_user_limited_channels = false
join_leave = false
force_push_join_leave = false

# Personal game notifications. History and recovery let a reconnecting client
# receive what it missed (#28).
[[channel.namespaces]]
name = "player"
subscribe_proxy_enabled = true
sub_refresh_proxy_enabled = true
history_size = 128
history_ttl = "300s"
force_recovery = true
force_positioning = true
allow_publish_for_client = false
allow_publish_for_subscriber = false
allow_publish_for_anonymous = false
allow_history_for_client = false
allow_history_for_subscriber = false
allow_history_for_anonymous = false
allow_presence_for_client = false
allow_presence_for_subscriber = false
allow_presence_for_anonymous = false
allow_user_limited_channels = false
join_leave = false
force_push_join_leave = false
