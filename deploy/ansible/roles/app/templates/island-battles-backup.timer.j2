# {{ ansible_managed }}
# Backs the database up once a day. Persistent catches up on a run that the VM
# missed while it was off.
[Unit]
Description=Back up the {{ postgres_database }} and {{ lobby_database }} databases every day

[Timer]
OnCalendar=*-*-* {{ app_backup_time }}:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
