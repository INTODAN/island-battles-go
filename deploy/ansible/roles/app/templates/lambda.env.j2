# {{ ansible_managed }}
# Written by `scripts/vm.sh deploy`. The settings the backend Lambda needs to
# reach the VM (#38), plus its admin API key (#37). Contains secrets: keep it
# in deploy/local/, never commit it.
#
# The database URL uses sslmode=require: encrypted, but the server certificate
# isn't checked. To check it, ship deploy/local/secrets/postgres-tls/server.crt
# with the Lambda and use sslmode=verify-full&sslrootcert=<path to it>.
ISLAND_BATTLES_DATABASE_URL=postgres://{{ postgres_app_role }}:{{ postgres_app_password }}@{{ vm_hostname }}:{{ app_postgres_published_port }}/{{ postgres_database }}?sslmode=require
ISLAND_BATTLES_CENTRIFUGO_PUBLIC_URL=wss://{{ vm_hostname }}/connection/websocket
ISLAND_BATTLES_CENTRIFUGO_API_URL=https://{{ vm_hostname }}/api
ISLAND_BATTLES_CENTRIFUGO_API_KEY={{ centrifugo_api_key }}
ISLAND_BATTLES_CONNECTION_TOKEN_HMAC_SECRET={{ connection_token_hmac_secret }}
ISLAND_BATTLES_LOBBY_PROXY_SECRET={{ lobby_proxy_secret }}
ISLAND_BATTLES_ADMIN_API_KEY={{ admin_api_key }}
