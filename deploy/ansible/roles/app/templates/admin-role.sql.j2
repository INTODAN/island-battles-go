-- Creates the read-only role that the admin MCP server connects as (#79), or
-- resets its password and grants. It runs in the backend's database in one
-- transaction, so the role can never read all of lobby_sessions, not even
-- between the statements below. Plain SQL without psql commands, so the Go
-- tests in backend/cmd/admin-mcp run it too.
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ postgres_admin_role }}') THEN
    CREATE ROLE "{{ postgres_admin_role }}" LOGIN;
  END IF;
END
$$;

ALTER ROLE "{{ postgres_admin_role }}"
  WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS
  PASSWORD '{{ postgres_admin_password }}';

-- The admin server sets both for its own sessions. The role keeps them for
-- any other client, such as psql.
ALTER ROLE "{{ postgres_admin_role }}" SET default_transaction_read_only = on;
ALTER ROLE "{{ postgres_admin_role }}" SET statement_timeout = '5s';

GRANT CONNECT ON DATABASE "{{ postgres_database }}" TO "{{ postgres_admin_role }}";

-- pg_logical_emit_message writes WAL that a rollback doesn't undo, so a loop
-- of them could fill the VM's disk even from a read-only transaction.
-- Everyone may call it by default, and nothing in the backend does, so it is
-- revoked from PUBLIC, in every signature this PostgreSQL version has. The
-- superuser keeps it.
DO $$
DECLARE
  emit_message regprocedure;
BEGIN
  FOR emit_message IN SELECT oid::regprocedure FROM pg_proc WHERE proname = 'pg_logical_emit_message' LOOP
    EXECUTE format('REVOKE EXECUTE ON FUNCTION %s FROM PUBLIC', emit_message);
  END LOOP;
END
$$;
GRANT USAGE ON SCHEMA public TO "{{ postgres_admin_role }}";
GRANT SELECT ON ALL TABLES IN SCHEMA public TO "{{ postgres_admin_role }}";

-- Sessions without bearer_hash, the digest of each guest's credential.
-- Revoking the table's SELECT also revokes its column grants, so the
-- columns are granted again after it.
--
-- Default privileges let the role read tables that later migrations create.
-- They are only set once lobby_sessions exists: set before, they would let
-- the role read all of it once the first migration created it. On a new VM
-- the role can read nothing until a VM deploy runs after that migration.
-- A restore leaves no grants, and every VM deploy and restore runs this
-- again.
DO $$
BEGIN
  IF to_regclass('public.lobby_sessions') IS NOT NULL THEN
    REVOKE SELECT ON public.lobby_sessions FROM "{{ postgres_admin_role }}";
    GRANT SELECT (id, player_id, created_at, expires_at) ON public.lobby_sessions TO "{{ postgres_admin_role }}";
    ALTER DEFAULT PRIVILEGES FOR ROLE "{{ postgres_app_role }}" IN SCHEMA public
      GRANT SELECT ON TABLES TO "{{ postgres_admin_role }}";
  END IF;
END
$$;
