# {{ ansible_managed }}
# Written by scripts/lambda-env.sh: the backend Lambda's settings, from
# INTODAN/mpl's settings for the tenant {{ lambda_env_tenant_key }} (the deploy
# bucket's mpl/tenants/{{ lambda_env_tenant_key }}/tenant.env) and this repository's own
# secrets. Terraform adds the rest (deploy/terraform/lambda.tf).
# Contains secrets: keep it in deploy/local/, never commit it.
#
# Island Battles' database on the VM's Postgres, which INTODAN/mpl runs.
ISLAND_BATTLES_DATABASE_URL={{ lambda_env_tenant.DATABASE_URL }}
# Centrifugo's HTTP API, which the game publishes its events with.
ISLAND_BATTLES_CENTRIFUGO_API_URL={{ lambda_env_tenant.CENTRIFUGO_API_URL }}
ISLAND_BATTLES_CENTRIFUGO_API_KEY={{ lambda_env_tenant.CENTRIFUGO_API_KEY }}
# The lobby, and the shared secret of its hooks and game API.
ISLAND_BATTLES_LOBBY_URL={{ lambda_env_tenant.LOBBY_URL | regex_replace('/$', '') }}
ISLAND_BATTLES_LOBBY_HOOK_SECRET={{ lambda_env_tenant.LOBBY_GAME_SECRET }}
# This repository's own secrets.
ISLAND_BATTLES_ADMIN_API_KEY={{ admin_api_key }}
ISLAND_BATTLES_SUBMIT_TOKEN_SECRET={{ submit_token_secret }}
