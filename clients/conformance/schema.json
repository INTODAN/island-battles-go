{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDK conformance scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "scenarios"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "const": "game"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirements",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "initial": {
            "type": "object"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "start"
                    },
                    "error": {
                      "enum": [
                        "authentication",
                        "protocol",
                        "closed",
                        "validation",
                        "transport",
                        "http",
                        "strategy"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "server"
                    },
                    "state": {
                      "type": "object"
                    },
                    "get_status": {
                      "type": "integer"
                    },
                    "post_status": {
                      "type": "integer"
                    },
                    "transport_failures": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "origin",
                    "destination",
                    "amount"
                  ],
                  "properties": {
                    "action": {
                      "const": "send"
                    },
                    "origin": {},
                    "destination": {},
                    "amount": {},
                    "error": {
                      "enum": [
                        "authentication",
                        "protocol",
                        "closed",
                        "validation",
                        "transport",
                        "http",
                        "strategy"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "return"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "fail"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "error"
                  ],
                  "properties": {
                    "action": {
                      "const": "wait_error"
                    },
                    "error": {
                      "enum": [
                        "authentication",
                        "protocol",
                        "closed",
                        "validation",
                        "transport",
                        "http",
                        "strategy"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "publish"
                    },
                    "state": {
                      "type": "object"
                    },
                    "schema_version": {},
                    "type": {}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "reconnect"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "refresh"
                    },
                    "error": {
                      "enum": [
                        "authentication",
                        "protocol",
                        "closed",
                        "validation",
                        "transport",
                        "http",
                        "strategy"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "expired_send"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "close"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "mark_gets"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "assert"
                    },
                    "callbacks": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "factory_colors": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "generation": {
                      "type": "integer"
                    },
                    "requests": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "game_id",
                          "generation_id",
                          "complete",
                          "commands"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "game_id": {
                            "type": "integer"
                          },
                          "generation_id": {
                            "type": "integer"
                          },
                          "complete": {
                            "type": "boolean"
                          },
                          "commands": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "same_requests": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "different_request_ids": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "startup_order": {
                      "const": true
                    },
                    "unchanged_gets": {
                      "const": true
                    },
                    "closed": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
