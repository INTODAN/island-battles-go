{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island Battles",
  "version": "0.1.0",
  "identifier": "org.elidan.islandbattles",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Island Battles",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://island-battles.elidan.org wss://vm.elidan.org http://127.0.0.1:41414"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "category": "Game",
    "shortDescription": "Island Battles desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
