{
  "app": {
    "security": {
      "capabilities": ["main", "dev"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8888 ws://localhost:8000 ws://127.0.0.1:8000 http://127.0.0.1:41414"
      }
    }
  }
}
