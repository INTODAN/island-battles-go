    "check": "biome ci . && bun run tools/codegen/generate.ts --check && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.1",
    "centrifuge": "5.7.4",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
