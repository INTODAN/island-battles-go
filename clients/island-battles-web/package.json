{
  "name": "island-battles-web",
  "private": true,
  "workspaces": [
    "tools/codegen"
  ],
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "bun run build.ts",
    "generate": "bun run tools/codegen/generate.ts",
    "check": "biome ci . && bun run tools/codegen/generate.ts --check && tsc --noEmit && bun test",
    "build:desktop": "bun run build.ts --desktop",
    "desktop:dev": "bun run build.ts --desktop --dev && tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "bun run build.ts --desktop && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@babylonjs/gui": "9.33.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "centrifuge": "5.7.4",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
