{
  "name": "island-battles-web",
  "private": true,
  "workspaces": [
    "tools/codegen"
  ],
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "bun run build.ts",
