{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!dist-desktop",
      "!src-tauri/target",
      "!src-tauri/gen",
      "!bun.lock",
      "!src/api/generated",
      "!**/*.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "css": { "formatter": { "enabled": true } },
  "json": { "formatter": { "enabled": true } }
}
