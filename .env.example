# Local development only. Copy to .env before running Docker Compose, then
# replace every value before deploying. These values must never be shipped in a
# client artifact.
ISLAND_BATTLES_DATABASE_URL=postgres://islandBattles:islandBattles@localhost:5432/islandBattles?sslmode=disable
ISLAND_BATTLES_HTTP_ADDR=:8888
ISLAND_BATTLES_CENTRIFUGO_PUBLIC_URL=ws://localhost:8000/connection/websocket
ISLAND_BATTLES_CENTRIFUGO_API_URL=http://localhost:8000/api
ISLAND_BATTLES_CENTRIFUGO_API_KEY=local-development-centrifugo-api-key-change-me
ISLAND_BATTLES_CONNECTION_TOKEN_HMAC_SECRET=local-development-connection-token-secret-change-me
ISLAND_BATTLES_LOBBY_PROXY_SECRET=local-development-lobby-proxy-secret-change-me
# Signs the one-turn submit tokens that bots submit their commands with.
ISLAND_BATTLES_SUBMIT_TOKEN_SECRET=local-development-submit-token-secret-change-me
# The lobby's player token keys, kid:seed pairs separated by commas, where seed
# is an Ed25519 seed of 32 bytes in base64url without padding. The first key
# signs; all are published. This placeholder decodes to
# "local-development-key-change-me!". Make a new seed with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOBBY_PLAYER_TOKEN_KEYS=local:bG9jYWwtZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1tZSE
# Optional, for development only: how long a player token lasts, from 1m to
# the default 15m, to see clients renew their tokens without a long game.
# LOBBY_PLAYER_TOKEN_LIFETIME=1m
# Optional; the game's public URL, which bots submit their commands to. Unset,
# each request's own address is used, which suits a local backend. It is also
# the iss of the player tokens; unset, that is urn:island-battles:local-lobby.
# ISLAND_BATTLES_PUBLIC_URL=http://localhost:8888
# Sent as X-Admin-API-Key to POST /map/create. Unset, that endpoint refuses
# every request.
ISLAND_BATTLES_ADMIN_API_KEY=local-development-admin-api-key-change-me
# Optional; the S3 bucket of the lobbies' bot packages, set on Lambda by
# Terraform. Unset, the local backend keeps them on disk, in
# ISLAND_BATTLES_BOT_PACKAGES_DIR (a folder in the system's temporary folder by
# default), behind a fake S3 at /local-s3/. See backend/README.md#bot-packages.
# ISLAND_BATTLES_BOT_PACKAGES_BUCKET=
# ISLAND_BATTLES_BOT_PACKAGES_DIR=/tmp/island-battles-bot-packages
# Offers hosted and uploaded bots, which the server plays without a player's
# tab, in the bot pickers and for bot seats: on or off. Off by default; on for
# development. Until the server sends them turns, a game with these bots plays
# only through the turn deadline. See backend/README.md#hosted-and-uploaded-bots.
ISLAND_BATTLES_SERVER_BOTS=on
# Optional database pool limits; see backend/README.md#the-connection-pool.
# ISLAND_BATTLES_DATABASE_MAX_OPEN_CONNECTIONS=2
# ISLAND_BATTLES_DATABASE_MAX_IDLE_CONNECTIONS=2
# ISLAND_BATTLES_DATABASE_CONNECTION_MAX_IDLE_TIME=1m
# Optional; how long a game is kept after its last turn. See backend/README.md#game-retention.
# ISLAND_BATTLES_GAME_RETENTION_PERIOD=168h
ISLAND_BATTLES_CENTRIFUGO_ADMIN_PASSWORD=local-admin-password-change-me
ISLAND_BATTLES_CENTRIFUGO_ADMIN_SECRET=local-development-admin-secret-change-me

# Override with the origins of the deployed web app, separated by spaces.
ISLAND_BATTLES_CENTRIFUGO_ALLOWED_ORIGINS="http://localhost:8888 http://127.0.0.1:8888 http://localhost:3000 http://127.0.0.1:3000 tauri://localhost http://tauri.localhost"
