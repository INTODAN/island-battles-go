# Local development only. Copy to .env before running Docker Compose, then
# replace every value before deploying. These values must never be shipped in a
# client artifact.
ISLAND_BATTLES_DATABASE_URL=postgres://islandBattles:islandBattles@localhost:5432/islandBattles?sslmode=disable
ISLAND_BATTLES_HTTP_ADDR=:8888
ISLAND_BATTLES_CENTRIFUGO_PUBLIC_URL=ws://localhost:8000/connection/websocket
ISLAND_BATTLES_CENTRIFUGO_API_URL=http://localhost:8000/api
ISLAND_BATTLES_CENTRIFUGO_API_KEY=local-development-centrifugo-api-key-change-me
ISLAND_BATTLES_CONNECTION_TOKEN_HMAC_SECRET=local-development-connection-token-secret-change-me
ISLAND_BATTLES_LOBBY_PROXY_SECRET=local-development-lobby-proxy-secret-change-me
# Sent as X-Admin-API-Key to POST /map/create. Unset, that endpoint refuses
# every request.
ISLAND_BATTLES_ADMIN_API_KEY=local-development-admin-api-key-change-me
# Optional database pool limits; see backend/README.md#the-connection-pool.
# ISLAND_BATTLES_DATABASE_MAX_OPEN_CONNECTIONS=2
# ISLAND_BATTLES_DATABASE_MAX_IDLE_CONNECTIONS=2
# ISLAND_BATTLES_DATABASE_CONNECTION_MAX_IDLE_TIME=1m
# Optional; how long a game is kept after its last turn. See backend/README.md#game-retention.
# ISLAND_BATTLES_GAME_RETENTION_PERIOD=168h
ISLAND_BATTLES_CENTRIFUGO_ADMIN_PASSWORD=local-admin-password-change-me
ISLAND_BATTLES_CENTRIFUGO_ADMIN_SECRET=local-development-admin-secret-change-me

# Override with the origins of the deployed web app, separated by spaces.
ISLAND_BATTLES_CENTRIFUGO_ALLOWED_ORIGINS="http://localhost:8888 http://127.0.0.1:8888 http://localhost:3000 http://127.0.0.1:3000"
